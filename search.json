---
layout: none
permalink: /search.json
---
[
  {% assign all_pages = site.pages | concat: site.posts %}
  {% for page in all_pages %}
    {% if page.title and page.title != "" and page.url != "/search.json" %}
  {
    "title": {{ page.title | jsonify }},
    "url": {{ page.url | jsonify }},
    "description": {{ page.description | default: "" | jsonify }},
    "category": {{ page.category | default: page.layout | default: "Page" | jsonify }},
    "keywords": {{ page.keywords | default: "" | jsonify }},
    "emoji": {{ page.tool_emoji | default: "" | jsonify }}
  }{% unless forloop.last %},{% endunless %}
  {% endif %}
  {% endfor %}
]
