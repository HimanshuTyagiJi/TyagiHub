---
layout: null
permalink: /shield.json
---
[
  {% assign hi_shield = site.shield_hi %}
  {% assign en_shield = site.shield | where_exp: "item", "item.lang != 'hi'" %}
  {% assign all_clean_shield = hi_shield | concat: en_shield | uniq %}
  
  {% for p in all_clean_shield %}
  {
    "title": {{ p.title | jsonify }},
    "url": {{ p.url | relative_url | jsonify }},
    "image": {{ p.image | default: '/assets/images/default-thumb.png' | jsonify }},
    "description": {{ p.description | default: p.excerpt | strip_html | truncate: 110 | jsonify }},
    "categories": [{{ p.categories | first | default: "cyber-security" | downcase | jsonify }}],
    "date": {{ p.date | date: "%Y-%m-%d" | jsonify }},
    "lang": {{ p.lang | default: "en" | jsonify }}
  }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]
