---
permalink: /assets/data/discover-feed.json
---
[
  {% assign english_posts = site.posts %}
  {% assign hindi_posts = site.posts_hi %}
  {% assign combined_posts = english_posts | concat: hindi_posts | sort: "date" | reverse %}
  {% for p in combined_posts %}
    {
      "title": {{ p.title | jsonify }},
      "url": {{ p.url | relative_url | jsonify }},
      "image": {{ p.image | default: '/assets/images/default-thumb.png' | jsonify }},
      "category": {{ p.categories | first | default: "Technology" | jsonify }},
      "categories": [{% if p.categories.size > 0 %}{% for cat in p.categories %}{{ cat | downcase | jsonify }}{% unless forloop.last %},{% endunless %}{% endfor %}{% else %}{{ p.categories | downcase | jsonify }}{% endif %}],
      "date": {{ p.date | date: "%d %b %Y" | jsonify }},
      "lang": {{ p.lang | default: "en" | jsonify }},
      "description": {{ p.description | default: p.excerpt | strip_html | truncate: 110 | jsonify }}
    }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]
